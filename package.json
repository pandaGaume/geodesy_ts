{
    "name": "@spacexr/geodesy",
    "version": "0.1.0",
    "description": "Renderer-neutral ellipsoid, geodetic, ECEF and local tangent frame primitives for SpaceXR.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (SpaceXR)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/geodesy_ts.git"
    },
    "homepage": "https://github.com/pandaGaume/geodesy_ts#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/geodesy_ts/issues"
    },
    "keywords": [
        "geodesy",
        "ecef",
        "ellipsoid",
        "wgs84",
        "enu",
        "ned",
        "spacexr"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./ellipsoid": {
            "types": "./dist/ellipsoid.d.ts",
            "import": "./dist/ellipsoid.js",
            "default": "./dist/ellipsoid.js"
        },
        "./system": {
            "types": "./dist/system.d.ts",
            "import": "./dist/system.js",
            "default": "./dist/system.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "clean": "rimraf dist coverage docs/api",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --coverage.enabled=false",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md}\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md}\"",
        "docs": "typedoc --options typedoc.json",
        "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build && npm run docs",
        "prepublishOnly": "npm run check"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.0",
        "prettier": "^3.2.0",
        "rimraf": "~6.0.1",
        "tslib": "^2.8.1",
        "tsup": "^8.5.1",
        "typedoc": "^0.28.0",
        "typescript": "^5.4.0",
        "vitest": "4.1.11"
    }
}
